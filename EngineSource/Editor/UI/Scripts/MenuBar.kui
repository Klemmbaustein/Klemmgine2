element MenuBarButton
{
	var Name = "File"
	leftPadding = 4px

	child UIButton button
	{
		upPadding = 1px
		downPadding = 1px
		minSize = (24, 18)px
		color = Color_DarkBackground
		verticalAlign = centered

		corners = Theme_CornerSize

		child UIText
		{
			size = 12px
			color = Color_Text
			padding = 4px

			text = Name
		}
	}
}